# Docker Compose Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git!

# Database Configuration
POSTGRES_USER=bank
POSTGRES_PASSWORD=your_secure_database_password_here
POSTGRES_DB=bank

# Redis Configuration (optional, defaults to redis:6379)
REDIS_ADDR=redis:6379

# JWT Secret (REQUIRED - generate a strong random secret)
# Generate with: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_key_here_generate_with_openssl_rand

# Metrics Authentication (REQUIRED for /metrics endpoint)
# These credentials protect the Prometheus metrics endpoint
# Generate with: openssl rand -base64 16
METRICS_USERNAME=metrics
METRICS_PASSWORD=your_metrics_password_here_generate_with_openssl_rand

# SMTP Configuration for Email (optional)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_SENDER=noreply@minibank.example.com

# Proxy Configuration (optional, defaults to false)
# Set to "true" if running behind a reverse proxy (nginx, AWS ALB, Cloudflare, etc.)
# When true, the app will trust X-Forwarded-For headers for client IP extraction
# This is important for accurate rate limiting and audit logging behind proxies
# WARNING: Only enable this if you have a trusted reverse proxy in front of your app!
TRUST_PROXY=false
